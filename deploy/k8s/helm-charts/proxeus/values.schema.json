{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "proxeus chart values",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "nameOverride": { "type": ["string", "null"] },
    "fullnameOverride": { "type": ["string", "null"] },
    "deployment": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "strategy": { "type": "object" }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "configmapReloader": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "webLifecycle": { "type": "boolean" },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] },
        "labels": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": ["string", "null"] }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "extraRules": { "type": "array", "items": { "type": "object" } }
      }
    },
    "hpa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1 },
        "behavior": { "type": "object" }
      }
    },
    "verticalAutoscaler": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "updateMode": { "type": "string", "enum": ["Off", "Initial", "Recreate", "Auto"] },
        "containerPolicies": { "type": "array", "items": { "type": "object" } }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "extraLabels": { "type": "object" },
        "clusterIP": { "type": "string" },
        "externalIPs": { "type": "array", "items": { "type": "string" } },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressClassName": { "type": "string" },
        "annotations": { "type": "object" },
        "extraLabels": { "type": "object" },
        "path": { "type": "string" },
        "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] },
        "hosts": { "type": "array", "items": { "type": "string" } },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "array", "items": { "type": "object" } },
        "egress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceMonitor": { "$ref": "#/definitions/monitor" },
    "podMonitor": { "$ref": "#/definitions/monitor" },
    "podSecurityContext": { "type": ["object", "null"] },
    "securityContext": { "type": ["object", "null"] },
    "storage": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/.+" },
        "emptyDir": { "type": ["object", "null"] },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "storageClassName": { "type": "string" },
            "accessModes": {
              "type": "array",
              "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
            },
            "size": { "type": "string" },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "shutdownDelay": { "$ref": "#/definitions/duration" },
    "shutdownTimeout": { "$ref": "#/definitions/duration" },
    "terminationGracePeriodSeconds": { "type": ["integer", "string", "null"] },
    "resources": { "type": "object" },
    "mcp": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSeries": { "type": "integer", "minimum": 0 },
        "maxSamples": { "type": "integer", "minimum": 0 },
        "queryTimeout": { "$ref": "#/definitions/duration" },
        "authenticatedByProxy": { "type": "boolean" }
      }
    },
    "webConfig": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "extraSecretMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "secretName", "mountPath"],
        "properties": {
          "name": { "type": "string" },
          "secretName": { "type": "string" },
          "mountPath": { "type": "string", "pattern": "^/.+" },
          "readOnly": { "type": "boolean" },
          "defaultMode": { "type": "integer" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "extraContainers": { "type": "array", "items": { "type": "object" } },
    "initContainers": { "type": "array", "items": { "type": "object" } },
    "configCheck": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": { "type": "object" }
      }
    },
    "env": { "type": "array", "items": { "type": "object" } },
    "envFrom": { "type": "array", "items": { "type": "object" } },
    "extraArgs": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "extraLabels": { "type": "object" },
    "annotations": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "configMap": { "type": "string" },
    "config": { "type": "object" }
  },
  "definitions": {
    "duration": {
      "description": "go duration as an integer plus s, m or h; the chart converts it to seconds",
      "type": "string",
      "pattern": "^[0-9]+(s|m|h)$"
    },
    "monitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "$ref": "#/definitions/duration" },
        "scrapeTimeout": { "type": "string", "pattern": "^([0-9]+(s|m|h))?$" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "honorLabels": { "type": "boolean" },
        "relabelings": { "type": "array", "items": { "type": "object" } },
        "metricRelabelings": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
